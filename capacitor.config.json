{
  "appId": "com.aura.app",
  "appName": "AURA V1",
  "webDir": "src",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0B0E14",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0E14"
    }
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true
  }
}
